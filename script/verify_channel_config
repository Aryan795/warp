#!/usr/bin/env bash
#
# Verifies that the pinned warp-channel-config generator (see
# ./script/install_channel_config) emits the expected `platform_root_url` for
# each channel (APP-5583). Run this after bumping the pinned revision so a
# generator that silently drops the field fails loudly here instead of
# routing every viewer back to Oz.
#
# Usage:
#   ./script/verify_channel_config

set -e

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")"/.. && pwd)"
cd "${REPO_ROOT}"

./script/install_channel_config

BIN_NAME="warp-channel-config"
if ! command -v "${BIN_NAME}" &>/dev/null; then
    echo "Error: ${BIN_NAME} not found on PATH after install_channel_config." >&2
    exit 1
fi

check_platform_root_url() {
    local channel="$1"
    local expected="$2"
    local actual
    actual="$("${BIN_NAME}" --channel "${channel}" --target-family native --target-os linux \
        | python3 -c 'import json, sys; print(json.load(sys.stdin)["oz_config"].get("platform_root_url"))')"
    if [ "${actual}" != "${expected}" ]; then
        echo "Error: channel '${channel}' expected platform_root_url '${expected}', got '${actual}'." >&2
        exit 1
    fi
    echo "OK: ${channel} -> ${actual}"
}

check_platform_root_url "dev" "https://platform.staging.warp.dev"
check_platform_root_url "stable" "https://platform.warp.dev"
check_platform_root_url "preview" "https://platform.warp.dev"
check_platform_root_url "local" "https://platform.staging.warp.dev"

echo "All channel configs emit the expected platform_root_url."
